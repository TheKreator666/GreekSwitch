<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>GreekSwitch.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- Dictionaries and trigram models are embedded so the published exe is a true single file. -->
  <ItemGroup>
    <!-- Word forms of el_GR/en_US, affix-expanded and hashed by tools/NgramBuilder (data/lexicon/README.md). -->
    <EmbeddedResource Include="..\..\data\lexicon\*.lex"
                      LogicalName="GreekSwitch.lexicon.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\data\ngrams\*.tri"
                      LogicalName="GreekSwitch.ngrams.%(Filename)%(Extension)" />
    <!-- Word frequencies (wordfreq, CC BY-SA 4.0), compiled by tools/FrequencyTableBuilder. -->
    <EmbeddedResource Include="..\..\data\frequency\*.zipf"
                      LogicalName="GreekSwitch.frequency.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GreekSwitch.Core.Tests" />
    <InternalsVisibleTo Include="GreekSwitch.TestSupport" />
    <InternalsVisibleTo Include="GreekSwitch.Evaluation" />
  </ItemGroup>

</Project>
