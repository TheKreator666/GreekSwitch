<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Decision-quality evaluation (milestone 9). Test-only, never shipped. Runs with `dotnet test`
    and fails if a false-positive rate rises above Data/baseline.json.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
    <Using Include="GreekSwitch.TestSupport" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GreekSwitch.Core\GreekSwitch.Core.csproj" />
    <ProjectReference Include="..\GreekSwitch.TestSupport\GreekSwitch.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Data\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\frequency\*.tsv" Link="Data\frequency\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
